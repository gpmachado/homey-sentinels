{
  "title": { "en": "Get voltage statistics" },
  "titleFormatted": { "en": "Get voltage statistics for [[monitor]], period: [[period]]" },
  "args": [
    { "name": "monitor", "type": "autocomplete", "title": { "en": "Monitor" } },
    { "name": "period", "type": "dropdown", "title": { "en": "Period" }, "values": [
      { "id": "day", "label": { "en": "Today" } },
      { "id": "week", "label": { "en": "Last 7 days" } },
      { "id": "month", "label": { "en": "Last 30 days" } },
      { "id": "all", "label": { "en": "All history" } }
    ] }
  ],
  "tokens": [
    { "name": "average_voltage", "type": "number", "title": { "en": "Average voltage (V)" } },
    { "name": "min_voltage", "type": "number", "title": { "en": "Minimum voltage (V)" } },
    { "name": "max_voltage", "type": "number", "title": { "en": "Maximum voltage (V)" } },
    { "name": "undervoltage_count", "type": "number", "title": { "en": "Undervoltage events" } },
    { "name": "undervoltage_duration", "type": "number", "title": { "en": "Undervoltage duration (seconds)" } },
    { "name": "overvoltage_count", "type": "number", "title": { "en": "Overvoltage events" } },
    { "name": "overvoltage_duration", "type": "number", "title": { "en": "Overvoltage duration (seconds)" } }
  ]
}
