{
  "title": { "en": "Create state group" },
  "titleFormatted": { "en": "Create state group [[name]] ([[type]]), expected: [[expected_state]]" },
  "hint": { "en": "For dynamic setup from a Flow. Groups are more easily created with checkboxes in the app's settings page." },
  "args": [
    { "name": "name", "type": "text", "title": { "en": "Group name" } },
    { "name": "type", "type": "dropdown", "title": { "en": "Group type" }, "values": [
      { "id": "contact", "label": { "en": "Contact" } },
      { "id": "light", "label": { "en": "Light" } },
      { "id": "switch", "label": { "en": "Switch" } },
      { "id": "valve", "label": { "en": "Valve" } },
      { "id": "garage", "label": { "en": "Garage door" } }
    ] },
    { "name": "expected_state", "type": "dropdown", "title": { "en": "Expected state" }, "values": [
      { "id": "true", "label": { "en": "On / Open" } },
      { "id": "false", "label": { "en": "Off / Closed" } }
    ] }
  ]
}
