    { "name": "counter", "type": "autocomplete", "title": { "en": "Counter" } },
    { "name": "period", "type": "dropdown", "title": { "en": "Period" }, "values": [
      { "id": "day", "label": { "en": "Today" } },
      { "id": "week", "label": { "en": "Last 7 days" } },
      { "id": "month", "label": { "en": "Last 30 days" } },
      { "id": "all", "label": { "en": "All history" } }
    ] }
  ],
  "tokens": [
    { "name": "event_count", "type": "number", "title": { "en": "Events" } },
    { "name": "last_event_at", "type": "string", "title": { "en": "Last event timestamp" } }
  ]
}
