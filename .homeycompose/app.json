{
  "id": "com.gpm.sentinels",
  "version": "1.0.13",
  "compatibility": ">=12.4.0",
  "sdk": 3,
  "runtime": "nodejs",
  "platforms": [
    "local"
  ],
  "name": {
    "en": "Sentinels",
    "da": "Sentinels",
    "de": "Sentinels",
    "es": "Sentinels",
    "fr": "Sentinels",
    "it": "Sentinels",
    "nl": "Sentinels",
    "no": "Sentinels",
    "sv": "Sentinels"
  },
  "description": {
    "en": "Observes existing devices and turns capability updates into activity, cycles, energy and statistics. Read-only — it never controls the devices it monitors.",
    "da": "Følger eksisterende enheder og gør opdateringer af deres funktioner til aktivitet, cyklusser, energi og statistik. Kun læsning: den styrer aldrig de enheder, den overvåger.",
    "de": "Beobachtet vorhandene Geräte und macht aus Capability-Updates Aktivität, Zyklen, Energie und Statistiken. Nur lesend: Es steuert nie die Geräte, die es überwacht.",
    "es": "Observa los dispositivos existentes y convierte las actualizaciones de sus capacidades en actividad, ciclos, energía y estadísticas. Solo lectura: nunca controla los dispositivos que vigila.",
    "fr": "Observe les appareils existants et transforme les mises à jour de leurs capacités en activité, cycles, énergie et statistiques. En lecture seule : il ne commande jamais les appareils qu'il surveille.",
    "it": "Osserva i dispositivi esistenti e trasforma gli aggiornamenti delle loro capacità in attività, cicli, energia e statistiche. Solo lettura: non controlla mai i dispositivi che monitora.",
    "nl": "Bekijkt bestaande apparaten en maakt van capability-updates activiteit, cycli, energie en statistieken. Alleen-lezen: het bestuurt nooit de apparaten die het bewaakt.",
    "no": "Følger eksisterende enheter og gjør oppdateringer av funksjonene deres om til aktivitet, sykluser, energi og statistikk. Bare lesing: den styrer aldri enhetene den overvåker.",
    "sv": "Följer befintliga enheter och gör om uppdateringar av deras funktioner till aktivitet, cykler, energi och statistik. Endast läsning: den styr aldrig de enheter den övervakar."
  },
  "category": [
    "tools"
  ],
  "brandColor": "#FF6D00",
  "permissions": [
    "homey:manager:api"
  ],
  "api": {
    "getDevices": {
      "method": "GET",
      "path": "/devices"
    },
    "getDevicesStatus": {
      "method": "GET",
      "path": "/devices/status"
    },
    "getAvailabilityWatchdogs": {
      "method": "GET",
      "path": "/availability-watchdogs"
    },
    "createAvailabilityWatchdog": {
      "method": "POST",
      "path": "/availability-watchdogs"
    },
    "deleteAvailabilityWatchdog": {
      "method": "DELETE",
      "path": "/availability-watchdogs/:deviceId"
    },
    "cleanupAvailabilityWatchdogs": {
      "method": "POST",
      "path": "/availability-watchdogs-cleanup"
    },
    "getAvailabilityScan": {
      "method": "GET",
      "path": "/availability-scan"
    },
    "runAvailabilityScan": {
      "method": "POST",
      "path": "/availability-scan"
    },
    "setAvailabilityExclusion": {
      "method": "POST",
      "path": "/availability-exclusions"
    },
    "getAvailabilitySettings": {
      "method": "GET",
      "path": "/availability-settings"
    },
    "setAvailabilitySettings": {
      "method": "POST",
      "path": "/availability-settings"
    },
    "getGroups": {
      "method": "GET",
      "path": "/groups"
    },
    "getMonitorsSummary": {
      "method": "GET",
      "path": "/monitors"
    },
    "getStandbyRanking": {
      "method": "GET",
      "path": "/standby-ranking"
    },
    "getUsagePattern": {
      "method": "GET",
      "path": "/usage-pattern/:id"
    },
    "createActivityMonitor": {
      "method": "POST",
      "path": "/monitors"
    },
    "deleteMonitor": {
      "method": "DELETE",
      "path": "/monitors/:id"
    },
    "resetMonitor": {
      "method": "POST",
      "path": "/monitors/:id/reset"
    },
    "rebuildMonitorHistory": {
      "method": "POST",
      "path": "/monitors/:id/rebuild-history"
    },
    "updateMonitor": {
      "method": "PUT",
      "path": "/monitors/:id"
    },
    "updateMonitorMessages": {
      "method": "PUT",
      "path": "/monitors/:id/messages"
    },
    "getStateMonitorsSummary": {
      "method": "GET",
      "path": "/state-monitors"
    },
    "createStateMonitor": {
      "method": "POST",
      "path": "/state-monitors"
    },
    "deleteStateMonitor": {
      "method": "DELETE",
      "path": "/state-monitors/:id"
    },
    "resetStateMonitor": {
      "method": "POST",
      "path": "/state-monitors/:id/reset"
    },
    "updateStateMonitor": {
      "method": "PUT",
      "path": "/state-monitors/:id"
    },
    "updateStateMonitorMessages": {
      "method": "PUT",
      "path": "/state-monitors/:id/messages"
    },
    "getVoltageMonitorsSummary": {
      "method": "GET",
      "path": "/voltage-monitors"
    },
    "createVoltageMonitor": {
      "method": "POST",
      "path": "/voltage-monitors"
    },
    "deleteVoltageMonitor": {
      "method": "DELETE",
      "path": "/voltage-monitors/:id"
    },
    "resetVoltageMonitor": {
      "method": "POST",
      "path": "/voltage-monitors/:id/reset"
    },
    "updateVoltageMonitor": {
      "method": "PUT",
      "path": "/voltage-monitors/:id"
    },
    "updateVoltageMonitorMessages": {
      "method": "PUT",
      "path": "/voltage-monitors/:id/messages"
    },
    "createGroup": {
      "method": "POST",
      "path": "/groups"
    },
    "updateGroup": {
      "method": "PUT",
      "path": "/groups/:id"
    },
    "deleteGroup": {
      "method": "DELETE",
      "path": "/groups/:id"
    },
    "checkGroupStatus": {
      "method": "GET",
      "path": "/groups/:id/check"
    },
    "cleanupGroup": {
      "method": "POST",
      "path": "/groups/:id/cleanup"
    },
    "clearGroupMismatch": {
      "method": "POST",
      "path": "/groups/:id/clear-mismatch"
    },
    "getMessageSettings": {
      "method": "GET",
      "path": "/message-settings"
    },
    "setMessageSettings": {
      "method": "POST",
      "path": "/message-settings"
    },
    "getDiagnostics": {
      "method": "GET",
      "path": "/diagnostics"
    },
    "getLogSettings": {
      "method": "GET",
      "path": "/log-settings"
    },
    "setLogSettings": {
      "method": "POST",
      "path": "/log-settings"
    },
    "getDefaultWording": {
      "method": "GET",
      "path": "/default-wording"
    },
    "getTimezone": {
      "method": "GET",
      "path": "/timezone"
    },
    "setTimezone": {
      "method": "POST",
      "path": "/timezone"
    }
  },
  "images": {
    "small": "/assets/images/small.png",
    "large": "/assets/images/large.png",
    "xlarge": "/assets/images/xlarge.png"
  },
  "author": {
    "name": "Gabriel Pedrosa Machado",
    "email": "g.machado@me.com"
  }
}
