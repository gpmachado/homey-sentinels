{
  "name": { "en": "Sentinels Overview" },
  "height": 300,
  "settings": [
    { "id": "title", "type": "text", "title": { "en": "Title" }, "hint": { "en": "Shown above the list. Leave empty for no title." }, "value": "" },
    { "id": "showAll", "type": "checkbox", "title": { "en": "Show every monitor" }, "hint": { "en": "Lists all your monitors and groups instead of the items picked below." }, "value": false },
    {
      "id": "kind", "type": "dropdown", "title": { "en": "Only show (with Show every monitor)" }, "value": "all",
      "values": [
        { "id": "all", "label": { "en": "Everything" } },
        { "id": "activity", "label": { "en": "Activity monitors" } },
        { "id": "state", "label": { "en": "State monitors" } },
        { "id": "voltage", "label": { "en": "Voltage monitors" } },
        { "id": "group", "label": { "en": "Groups" } },
        { "id": "binary", "label": { "en": "Event counters" } }
      ]
    },
    { "id": "monitor1", "type": "autocomplete", "title": { "en": "Item 1" } },
    { "id": "monitor2", "type": "autocomplete", "title": { "en": "Item 2" } },
    { "id": "monitor3", "type": "autocomplete", "title": { "en": "Item 3" } },
    { "id": "monitor4", "type": "autocomplete", "title": { "en": "Item 4" } },
    { "id": "monitor5", "type": "autocomplete", "title": { "en": "Item 5" } }
  ],
  "api": {
    "getSummary": { "method": "GET", "path": "/summary" },
    "getList": { "method": "GET", "path": "/list" }
  }
}
